BROKER_ID=broker.cce.dkfz.de
ROOT_CRT_FILE=/srv/docker/bridgehead/cce/root.crt.pem
if [ "$ENVIRONMENT" == "test" ]; then
	BROKER_ID=test-no-real-data.broker.samply.de
	ROOT_CRT_FILE=/srv/docker/bridgehead/cce/test.root.crt.pem
fi
BROKER_URL=https://${BROKER_ID}
PROXY_ID=${SITE_ID}.${BROKER_ID}
FOCUS_BEAM_SECRET_SHORT="$(cat /proc/sys/kernel/random/uuid | sed 's/[-]//g' | head -c 20)"
FOCUS_RETRY_COUNT=${FOCUS_RETRY_COUNT:-64}
SUPPORT_EMAIL=manoj.waikar@dkfz-heidelberg.de
PRIVATEKEYFILENAME=/etc/bridgehead/pki/${SITE_ID}.priv.pem
BROKER_URL_FOR_PREREQ=$BROKER_URL

for module in $PROJECT/modules/*.sh
do
    log DEBUG "sourcing $module"
    source $module
done